{
  "dpi": "original",
  "font": {
    "name": "Microsoft YaHei",
    "postScript": "",
    "fontSize": 24,
    "color": [0, 0, 0],
    "antiAlias": "smooth",
    "orientation": "vertical",
    "justification": "left",
    "autoLeading": true,
    "autoLeadingSize": 1.25,
    "leading": 0,
    "discretionaryLigatures": true,
    "standardVerticalRomanAlignment": true,
    "script": "auto"
  },
  "dbnet": {
    "enabled": true,
    "model": "dbnet_detect.onnx",
    "limitSideLen": 1024,
    "dbBinThreshold": 0.5,
    "dbBoxThreshold": 0.7,
    "dbUnclipRatio": 2.3,
    "minSide": 3.0,
    "segThreshold": 0.12,
    "minBoxArea": 64,
    "whiten": {
      "enabled": true,
      "color": [255, 255, 255],
      "margin": 3,
      "boxMarginX": 3,
      "boxMarginY": 3,
      "limitToBoxes": true,
      "layerName": "whites",
      "transparency": 0
    },
    "boxes": {
      "enabled": true,
      "color": [255, 0, 0],
      "layerName": "dbnet_boxes",
      "lock": true
    }
  },
  "bgCopy": {
    "enabled": true,
    "layerName": "bg 拷贝"
  },
  "layers": {
    "opacity": 100
  }
}
